# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build the magic-link/OAuth redirect URL. Set this to your deployed
# URL in Vercel's env vars (e.g. https://rasoi.vercel.app); leave as-is for
# local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
